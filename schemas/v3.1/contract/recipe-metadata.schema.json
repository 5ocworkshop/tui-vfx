{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeMetadata",
  "description": "Human-facing metadata for a canonical recipe document.",
  "type": "object",
  "properties": {
    "authors": {
      "description": "Optional authors or owning teams.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "description": {
      "description": "Optional longer recipe description.",
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "description": "Optional catalog/search tags.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "title": {
      "description": "Optional human-facing recipe title.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
