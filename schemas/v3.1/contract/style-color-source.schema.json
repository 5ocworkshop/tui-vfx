{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyleColorSource",
  "description": "Source of a color used by style interpolation tracks.",
  "oneOf": [
    {
      "description": "Explicit RGBA color.",
      "type": "object",
      "properties": {
        "explicitColor": {
          "description": "Explicit RGBA color value.",
          "$ref": "#/$defs/Color"
        },
        "kind": {
          "type": "string",
          "const": "explicitColor"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "explicitColor"
      ]
    },
    {
      "description": "Current canvas/background color under the subject.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "canvas"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Fully transparent color.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "transparent"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Subject's current authored color.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "current"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Sampled source surface color.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "sampledSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Destination/composited color.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "destination"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "Color": {
      "description": "RGBA color with alpha channel for compositing.\n\nUnlike framework-specific color types, this includes an alpha channel\nto enable proper effect layering and transparency.",
      "type": "object",
      "properties": {
        "a": {
          "description": "Alpha channel (0=transparent, 255=opaque)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "b": {
          "description": "Blue channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "description": "Green channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "description": "Red channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    }
  }
}
