{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalExpressionSpec",
  "description": "Deterministic numeric expression usable by preview loopbacks and authored value sources.",
  "oneOf": [
    {
      "description": "Constant numeric expression.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "constant"
        },
        "value": {
          "description": "Constant numeric value.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "description": "Repeating ramp from `start` to `end`.",
      "type": "object",
      "properties": {
        "end": {
          "description": "Value at normalized expression phase one.",
          "type": "number",
          "format": "double"
        },
        "kind": {
          "type": "string",
          "const": "ramp"
        },
        "start": {
          "description": "Value at normalized expression phase zero.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "start",
        "end"
      ]
    },
    {
      "description": "Sine oscillator.",
      "type": "object",
      "properties": {
        "amplitude": {
          "description": "Oscillator amplitude.",
          "type": "number",
          "format": "double"
        },
        "frequencyHz": {
          "description": "Oscillator frequency in hertz.",
          "type": "number",
          "format": "double"
        },
        "kind": {
          "type": "string",
          "const": "sine"
        },
        "offset": {
          "description": "Numeric offset added after oscillation.",
          "type": "number",
          "format": "double"
        },
        "phase": {
          "description": "Phase offset in cycles.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "frequencyHz",
        "amplitude",
        "offset",
        "phase"
      ]
    },
    {
      "description": "Triangle oscillator.",
      "type": "object",
      "properties": {
        "amplitude": {
          "description": "Oscillator amplitude.",
          "type": "number",
          "format": "double"
        },
        "frequencyHz": {
          "description": "Oscillator frequency in hertz.",
          "type": "number",
          "format": "double"
        },
        "kind": {
          "type": "string",
          "const": "triangle"
        },
        "offset": {
          "description": "Numeric offset added after oscillation.",
          "type": "number",
          "format": "double"
        },
        "phase": {
          "description": "Phase offset in cycles.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "frequencyHz",
        "amplitude",
        "offset",
        "phase"
      ]
    },
    {
      "description": "Mix two numeric expressions with a 0..1 blend factor.",
      "type": "object",
      "properties": {
        "a": {
          "description": "First expression.",
          "$ref": "#"
        },
        "b": {
          "description": "Second expression.",
          "$ref": "#"
        },
        "kind": {
          "type": "string",
          "const": "mix"
        },
        "mix": {
          "description": "Blend factor where 0 selects `a` and 1 selects `b`.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "a",
        "b",
        "mix"
      ]
    },
    {
      "description": "Add two numeric expressions.",
      "type": "object",
      "properties": {
        "a": {
          "description": "First expression.",
          "$ref": "#"
        },
        "b": {
          "description": "Second expression.",
          "$ref": "#"
        },
        "kind": {
          "type": "string",
          "const": "add"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "a",
        "b"
      ]
    },
    {
      "description": "Multiply two numeric expressions.",
      "type": "object",
      "properties": {
        "a": {
          "description": "First expression.",
          "$ref": "#"
        },
        "b": {
          "description": "Second expression.",
          "$ref": "#"
        },
        "kind": {
          "type": "string",
          "const": "multiply"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "a",
        "b"
      ]
    },
    {
      "description": "Clamp a numeric expression into an inclusive range.",
      "type": "object",
      "properties": {
        "input": {
          "description": "Expression input to clamp.",
          "$ref": "#"
        },
        "kind": {
          "type": "string",
          "const": "clamp"
        },
        "max": {
          "description": "Inclusive maximum value.",
          "type": "number",
          "format": "double"
        },
        "min": {
          "description": "Inclusive minimum value.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "input",
        "min",
        "max"
      ]
    }
  ]
}
