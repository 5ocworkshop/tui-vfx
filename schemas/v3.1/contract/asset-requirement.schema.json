{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetRequirement",
  "description": "Asset slot declared by a source descriptor.",
  "type": "object",
  "properties": {
    "description": {
      "description": "Optional human-facing slot description.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "description": "Exact asset format accepted by this source asset slot.",
      "$ref": "#/$defs/AssetFormat"
    },
    "kind": {
      "description": "Broad asset kind accepted by this source asset slot.",
      "$ref": "#/$defs/AssetKind"
    },
    "required": {
      "description": "Whether a source spec must supply this asset slot.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "format",
    "required"
  ],
  "$defs": {
    "AssetFormat": {
      "description": "Stable asset format identifier, such as `tui-vfx.braille_flag_asset.v1`.",
      "type": "string"
    },
    "AssetKind": {
      "description": "Broad source asset kind used for validation before runtime loading exists.",
      "oneOf": [
        {
          "description": "Raster or vector image-like source material.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "ANSI/terminal capture source material.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ansi"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Braille dotfield source material.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "brailleDotfield"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "JSON-encoded structured source data.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "json"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Pre-shaped cell-grid source material.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cellGrid"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Opaque binary source material.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Project-defined asset kind with explicit stable name.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "custom"
            },
            "name": {
              "description": "Stable custom asset kind name.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    }
  }
}
