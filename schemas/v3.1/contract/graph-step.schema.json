{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphStep",
  "description": "Canonical execution topology for a graph.",
  "oneOf": [
    {
      "description": "Execute one declared graph node.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "node"
        },
        "node": {
          "description": "Graph-local node id to execute.",
          "$ref": "#/$defs/NodeId"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "node"
      ]
    },
    {
      "description": "Execute child steps in order, where each child reads the prior output.",
      "type": "object",
      "properties": {
        "children": {
          "description": "Ordered child steps.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "kind": {
          "type": "string",
          "const": "sequence"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "children"
      ]
    },
    {
      "description": "Execute child branches against the same input snapshot, then merge deltas.",
      "type": "object",
      "properties": {
        "children": {
          "description": "Authored child branches. Child order is deterministic merge order.",
          "type": "array",
          "items": {
            "$ref": "#"
          }
        },
        "kind": {
          "type": "string",
          "const": "parallel"
        },
        "mergePolicy": {
          "description": "Policy used when multiple branches write the same cell channel.",
          "$ref": "#/$defs/ParallelMergePolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "children",
        "mergePolicy"
      ]
    }
  ],
  "$defs": {
    "NodeId": {
      "description": "Stable node identifier inside a canonical graph.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "ParallelMergePolicy": {
      "description": "Policy for resolving channel writes produced by parallel graph branches.",
      "oneOf": [
        {
          "description": "Merge branches in authored child order; later same-channel writes win.",
          "type": "string",
          "const": "childOrderLastWriterWins"
        },
        {
          "description": "Reject the merge when multiple branches write the same cell channel.",
          "type": "string",
          "const": "errorOnSameChannelConflict"
        }
      ]
    }
  }
}
