{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BindingSpec",
  "description": "Declarative binding from a value source to a parameter target.",
  "type": "object",
  "properties": {
    "bindingMode": {
      "description": "Declarative binding application mode.",
      "$ref": "#/$defs/BindingMode"
    },
    "bindingTarget": {
      "description": "Binding target that receives the value.",
      "$ref": "#/$defs/BindingTarget"
    },
    "valueSource": {
      "description": "Value source that provides the binding value.",
      "$ref": "#/$defs/ValueSource"
    }
  },
  "additionalProperties": false,
  "required": [
    "bindingTarget",
    "valueSource",
    "bindingMode"
  ],
  "$defs": {
    "BindingMode": {
      "description": "Declarative mode for applying a binding source to a target.",
      "oneOf": [
        {
          "description": "Source replaces the target value.",
          "type": "string",
          "const": "replace"
        }
      ]
    },
    "BindingTarget": {
      "description": "Declarative target for a value binding.",
      "oneOf": [
        {
          "description": "Binding targets a declared public parameter.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Referenced target parameter id.",
              "$ref": "#/$defs/ParameterId"
            },
            "kind": {
              "type": "string",
              "const": "parameter"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "ClockValueSource": {
      "description": "Numeric clock source exposed to canonical `ValueSource::Clock`.",
      "oneOf": [
        {
          "description": "Absolute recipe sample time in seconds.",
          "type": "string",
          "const": "recipeSeconds"
        },
        {
          "description": "Current lifecycle phase sample time in seconds.",
          "type": "string",
          "const": "phaseSeconds"
        },
        {
          "description": "Current loop-local sample time in seconds when a loop exists.",
          "type": "string",
          "const": "loopSeconds"
        }
      ]
    },
    "Color": {
      "description": "RGBA color with alpha channel for compositing.\n\nUnlike framework-specific color types, this includes an alpha channel\nto enable proper effect layering and transparency.",
      "type": "object",
      "properties": {
        "a": {
          "description": "Alpha channel (0=transparent, 255=opaque)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "b": {
          "description": "Blue channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "description": "Green channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "description": "Red channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "GradientSpec": {
      "description": "Canonical gradient value for descriptor inputs.",
      "type": "object",
      "properties": {
        "space": {
          "description": "Color interpolation space, such as `rgb` or `hct`.",
          "type": "string"
        },
        "stops": {
          "description": "Ordered or author-provided gradient stops.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GradientStop"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "stops",
        "space"
      ]
    },
    "GradientStop": {
      "description": "One color stop in a canonical gradient value.",
      "type": "object",
      "properties": {
        "color": {
          "description": "Color sampled at this stop.",
          "$ref": "#/$defs/Color"
        },
        "position": {
          "description": "Normalized stop position in the inclusive 0..1 range.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "color"
      ]
    },
    "GraphValueId": {
      "description": "Stable value identifier published into a canonical graph-local value bus.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "InternedRoleName": {
      "description": "Opaque interned name for a `RoleTag::Custom` variant.\n\nA newtype wrapper around `InternedString` so custom role names are\ndistinct at the type level from other interned identifiers\n(`LayerId`, `RecipeId`). Foreign code can read the inner name via\n`as_str()` but cannot accidentally substitute a `LayerId` for a role\nname or vice versa.",
      "type": "string"
    },
    "LifecyclePhase": {
      "description": "Named high-level interval in a recipe lifecycle.",
      "oneOf": [
        {
          "description": "Initial appearance or setup interval.",
          "type": "string",
          "const": "enter"
        },
        {
          "description": "Sustained interval that may be fixed or trigger-terminated.",
          "type": "string",
          "const": "dwell"
        },
        {
          "description": "Final departure or teardown interval.",
          "type": "string",
          "const": "exit"
        }
      ]
    },
    "NumericRange": {
      "description": "Optional inclusive numeric bounds for a value spec.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Inclusive maximum value when present.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "description": "Inclusive minimum value when present.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "ParameterId": {
      "description": "Stable public recipe parameter identifier.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "Rect": {
      "description": "Rectangle in cell coordinates.\n\nThis is the primary geometry type for defining effect regions.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Rectangle height in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "width": {
          "description": "Rectangle width in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "description": "Left edge x coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "description": "Top edge y coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RoleTag": {
      "description": "Per-cell semantic role tag.\n\nTwelve first-class variants cover the common roles. `Custom(name)` covers\nad-hoc recipe-declared roles. `#[non_exhaustive]` preserves room for\nfuture first-class additions without a breaking change.\n\nEvery first-class variant has a stable numeric ID in `RoleInterner`\n(Background=0, Text=1, …, Procedural=11); Custom IDs start at 12.",
      "oneOf": [
        {
          "description": "Fill cells (no glyph or styled space).",
          "type": "string",
          "const": "Background"
        },
        {
          "description": "Primary content text.",
          "type": "string",
          "const": "Text"
        },
        {
          "description": "Title / header text.",
          "type": "string",
          "const": "Title"
        },
        {
          "description": "Secondary / sub text.",
          "type": "string",
          "const": "Caption"
        },
        {
          "description": "Structural / decorative borders.",
          "type": "string",
          "const": "Border"
        },
        {
          "description": "Image / pixel-art / glyph-art cells.",
          "type": "string",
          "const": "Image"
        },
        {
          "description": "Small icon glyphs.",
          "type": "string",
          "const": "Icon"
        },
        {
          "description": "Status / focus / selection markers.",
          "type": "string",
          "const": "Indicator"
        },
        {
          "description": "Emphasized content (search hits, etc.).",
          "type": "string",
          "const": "Highlight"
        },
        {
          "description": "Shadow content — source layer or graph/render output.",
          "type": "string",
          "const": "Shadow"
        },
        {
          "description": "Ornamental cells (dividers, ornaments).",
          "type": "string",
          "const": "Decoration"
        },
        {
          "description": "Cells produced by a procedural source.",
          "type": "string",
          "const": "Procedural"
        },
        {
          "description": "Author-declared custom role, such as `\"logo_silhouette\"`.",
          "type": "object",
          "properties": {
            "Custom": {
              "description": "Custom role name serialized as a string.",
              "$ref": "#/$defs/InternedRoleName"
            }
          },
          "additionalProperties": false,
          "required": [
            "Custom"
          ]
        }
      ]
    },
    "ScopeSpec": {
      "description": "Minimal Phase A/B scope algebra.",
      "oneOf": [
        {
          "description": "Match every in-bounds cell.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells with the requested role in the active role space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role"
            },
            "role": {
              "description": "Role required in the active role space.",
              "$ref": "#/$defs/RoleTag"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "description": "Match a rectangle in the active coordinate space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "rect": {
              "description": "Rectangle to match in the active coordinate space.",
              "$ref": "#/$defs/Rect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rect"
          ]
        },
        {
          "description": "Match one cell using value sources for each coordinate.\n\nThis preserves runtime-bound cell targeting from the source pathway while\nstill allowing static literal coordinates for deterministic validation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cell"
            },
            "x": {
              "description": "X coordinate source in the active coordinate space.",
              "$ref": "#/$defs/ValueSource"
            },
            "y": {
              "description": "Y coordinate source in the active coordinate space.",
              "$ref": "#/$defs/ValueSource"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "x",
            "y"
          ]
        },
        {
          "description": "Match rows `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rowRange"
            },
            "start": {
              "description": "Inclusive start row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match columns `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "columnRange"
            },
            "start": {
              "description": "Inclusive start column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match rows where `row % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloRows"
            },
            "modulus": {
              "description": "Positive modulus used to select rows.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match columns where `column % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloColumns"
            },
            "modulus": {
              "description": "Positive modulus used to select columns.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match cells containing non-empty glyph content.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nonEmpty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match the outer perimeter band.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outerBand"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells that are not on the outer perimeter.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inner"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SignalExpressionSpec": {
      "description": "Deterministic numeric expression usable by preview loopbacks and authored value sources.",
      "oneOf": [
        {
          "description": "Constant numeric expression.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "constant"
            },
            "value": {
              "description": "Constant numeric value.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Repeating ramp from `start` to `end`.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Value at normalized expression phase one.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "ramp"
            },
            "start": {
              "description": "Value at normalized expression phase zero.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Sine oscillator.",
          "type": "object",
          "properties": {
            "amplitude": {
              "description": "Oscillator amplitude.",
              "type": "number",
              "format": "double"
            },
            "frequencyHz": {
              "description": "Oscillator frequency in hertz.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "sine"
            },
            "offset": {
              "description": "Numeric offset added after oscillation.",
              "type": "number",
              "format": "double"
            },
            "phase": {
              "description": "Phase offset in cycles.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frequencyHz",
            "amplitude",
            "offset",
            "phase"
          ]
        },
        {
          "description": "Triangle oscillator.",
          "type": "object",
          "properties": {
            "amplitude": {
              "description": "Oscillator amplitude.",
              "type": "number",
              "format": "double"
            },
            "frequencyHz": {
              "description": "Oscillator frequency in hertz.",
              "type": "number",
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "triangle"
            },
            "offset": {
              "description": "Numeric offset added after oscillation.",
              "type": "number",
              "format": "double"
            },
            "phase": {
              "description": "Phase offset in cycles.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "frequencyHz",
            "amplitude",
            "offset",
            "phase"
          ]
        },
        {
          "description": "Mix two numeric expressions with a 0..1 blend factor.",
          "type": "object",
          "properties": {
            "a": {
              "description": "First expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "b": {
              "description": "Second expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "kind": {
              "type": "string",
              "const": "mix"
            },
            "mix": {
              "description": "Blend factor where 0 selects `a` and 1 selects `b`.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "a",
            "b",
            "mix"
          ]
        },
        {
          "description": "Add two numeric expressions.",
          "type": "object",
          "properties": {
            "a": {
              "description": "First expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "b": {
              "description": "Second expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "kind": {
              "type": "string",
              "const": "add"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "a",
            "b"
          ]
        },
        {
          "description": "Multiply two numeric expressions.",
          "type": "object",
          "properties": {
            "a": {
              "description": "First expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "b": {
              "description": "Second expression.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "kind": {
              "type": "string",
              "const": "multiply"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "a",
            "b"
          ]
        },
        {
          "description": "Clamp a numeric expression into an inclusive range.",
          "type": "object",
          "properties": {
            "input": {
              "description": "Expression input to clamp.",
              "$ref": "#/$defs/SignalExpressionSpec"
            },
            "kind": {
              "type": "string",
              "const": "clamp"
            },
            "max": {
              "description": "Inclusive maximum value.",
              "type": "number",
              "format": "double"
            },
            "min": {
              "description": "Inclusive minimum value.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "input",
            "min",
            "max"
          ]
        }
      ]
    },
    "SignalId": {
      "description": "Stable host/runtime signal identifier.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "StructuredValue": {
      "description": "JSON-compatible structured payload owned by a descriptor field.\n\nUse this only when the primitive owns a nested payload whose stable shape is\ndescriptor-specific, such as path lists, particle options, or glyph-style\nrule tables. Prefer narrower typed values whenever a field has scalar,\ncolor, gradient, duration, scope, or rect semantics.",
      "anyOf": [
        {
          "description": "Explicit null.",
          "type": "null"
        },
        {
          "description": "Boolean leaf value.",
          "type": "boolean"
        },
        {
          "description": "Floating-point numeric leaf value.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "String leaf value.",
          "type": "string"
        },
        {
          "description": "Ordered child values.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredValue"
          }
        },
        {
          "description": "String-keyed object values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StructuredValue"
          }
        }
      ]
    },
    "Value": {
      "description": "Canonical tagged literal value used by effect input specs.",
      "oneOf": [
        {
          "description": "Explicit absence of a value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Boolean true/false literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "description": "Boolean payload.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Signed integer literal without a fractional component.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "description": "Integer payload.",
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Floating-point numeric literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "description": "Number payload.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Short machine-facing string literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "description": "String payload.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Human-facing text literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "description": "Text payload.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "RGBA color literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "description": "Color payload.",
              "$ref": "#/$defs/Color"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Gradient stop payload.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gradient"
            },
