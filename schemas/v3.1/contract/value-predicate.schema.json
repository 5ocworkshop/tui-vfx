{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValuePredicate",
  "description": "Typed predicate evaluated against a lifecycle trigger value source.",
  "oneOf": [
    {
      "description": "Source value must be boolean true.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "isTrue"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Source value must be boolean false.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "isFalse"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Source value must be a non-zero integer, number, or duration.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "nonZero"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Source value must be a non-empty string or text value.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "nonEmpty"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "description": "Source value must equal the typed literal.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "equals"
        },
        "value": {
          "description": "Typed literal used for equality comparison.",
          "$ref": "#/$defs/Value"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "description": "Source value must not equal the typed literal.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "notEquals"
        },
        "value": {
          "description": "Typed literal used for inequality comparison.",
          "$ref": "#/$defs/Value"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "description": "Source value must be greater than the typed numeric literal.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "greaterThan"
        },
        "value": {
          "description": "Typed numeric literal used as the exclusive lower bound.",
          "$ref": "#/$defs/Value"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "description": "Source value must be less than the typed numeric literal.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "lessThan"
        },
        "value": {
          "description": "Typed numeric literal used as the exclusive upper bound.",
          "$ref": "#/$defs/Value"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ]
    },
    {
      "description": "Convenience level predicate with documented per-kind truthiness behavior.\n\nThe contract truth table is boolean true, integer non-zero, finite number\nnon-zero, string/text non-empty, color or gradient value present, and finite duration\nnon-zero. Null, enum, role, scope, and rect have no I0 truth rule.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "truthy"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    }
  ],
  "$defs": {
    "Color": {
      "description": "RGBA color with alpha channel for compositing.\n\nUnlike framework-specific color types, this includes an alpha channel\nto enable proper effect layering and transparency.",
      "type": "object",
      "properties": {
        "a": {
          "description": "Alpha channel (0=transparent, 255=opaque)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "b": {
          "description": "Blue channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "description": "Green channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "description": "Red channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "GradientSpec": {
      "description": "Canonical gradient value for descriptor inputs.",
      "type": "object",
      "properties": {
        "space": {
          "description": "Color interpolation space, such as `rgb` or `hct`.",
          "type": "string"
        },
        "stops": {
          "description": "Ordered or author-provided gradient stops.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GradientStop"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "stops",
        "space"
      ]
    },
    "GradientStop": {
      "description": "One color stop in a canonical gradient value.",
      "type": "object",
      "properties": {
        "color": {
          "description": "Color sampled at this stop.",
          "$ref": "#/$defs/Color"
        },
        "position": {
          "description": "Normalized stop position in the inclusive 0..1 range.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "color"
      ]
    },
    "InternedRoleName": {
      "description": "Opaque interned name for a `RoleTag::Custom` variant.\n\nA newtype wrapper around `InternedString` so custom role names are\ndistinct at the type level from other interned identifiers\n(`LayerId`, `RecipeId`). Foreign code can read the inner name via\n`as_str()` but cannot accidentally substitute a `LayerId` for a role\nname or vice versa.",
      "type": "string"
    },
    "Rect": {
      "description": "Rectangle in cell coordinates.\n\nThis is the primary geometry type for defining effect regions.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Rectangle height in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "width": {
          "description": "Rectangle width in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "description": "Left edge x coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "description": "Top edge y coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RoleTag": {
      "description": "Per-cell semantic role tag.\n\nTwelve first-class variants cover the common roles. `Custom(name)` covers\nad-hoc recipe-declared roles. `#[non_exhaustive]` preserves room for\nfuture first-class additions without a breaking change.\n\nEvery first-class variant has a stable numeric ID in `RoleInterner`\n(Background=0, Text=1, …, Procedural=11); Custom IDs start at 12.",
      "oneOf": [
        {
          "description": "Fill cells (no glyph or styled space).",
          "type": "string",
          "const": "Background"
        },
        {
          "description": "Primary content text.",
          "type": "string",
          "const": "Text"
        },
        {
          "description": "Title / header text.",
          "type": "string",
          "const": "Title"
        },
        {
          "description": "Secondary / sub text.",
          "type": "string",
          "const": "Caption"
        },
        {
          "description": "Structural / decorative borders.",
          "type": "string",
          "const": "Border"
        },
        {
          "description": "Image / pixel-art / glyph-art cells.",
          "type": "string",
          "const": "Image"
        },
        {
          "description": "Small icon glyphs.",
          "type": "string",
          "const": "Icon"
        },
        {
          "description": "Status / focus / selection markers.",
          "type": "string",
          "const": "Indicator"
        },
        {
          "description": "Emphasized content (search hits, etc.).",
          "type": "string",
          "const": "Highlight"
        },
        {
          "description": "Shadow content — source layer OR pipeline output.",
          "type": "string",
          "const": "Shadow"
        },
        {
          "description": "Ornamental cells (dividers, ornaments).",
          "type": "string",
          "const": "Decoration"
        },
        {
          "description": "Cells produced by a procedural source.",
          "type": "string",
          "const": "Procedural"
        },
        {
          "description": "Author-declared custom role, such as `\"logo_silhouette\"`.",
          "type": "object",
          "properties": {
            "Custom": {
              "description": "Custom role name serialized as a string.",
              "$ref": "#/$defs/InternedRoleName"
            }
          },
          "additionalProperties": false,
          "required": [
            "Custom"
          ]
        }
      ]
    },
    "ScopeSpec": {
      "description": "Minimal Phase A/B scope algebra.",
      "oneOf": [
        {
          "description": "Match every in-bounds cell.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells with the requested role in the active role space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role"
            },
            "role": {
              "description": "Role required in the active role space.",
              "$ref": "#/$defs/RoleTag"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "description": "Match a rectangle in the active coordinate space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "rect": {
              "description": "Rectangle to match in the active coordinate space.",
              "$ref": "#/$defs/Rect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rect"
          ]
        },
        {
          "description": "Match rows `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rowRange"
            },
            "start": {
              "description": "Inclusive start row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match columns `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "columnRange"
            },
            "start": {
              "description": "Inclusive start column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match rows where `row % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloRows"
            },
            "modulus": {
              "description": "Positive modulus used to select rows.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match columns where `column % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloColumns"
            },
            "modulus": {
              "description": "Positive modulus used to select columns.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match cells containing non-empty glyph content.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nonEmpty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match the outer perimeter band.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outerBand"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells that are not on the outer perimeter.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inner"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "StructuredValue": {
      "description": "JSON-compatible structured payload owned by a descriptor field.\n\nUse this only when the primitive owns a nested payload whose stable shape is\ndescriptor-specific, such as path lists, particle options, or glyph-style\nrule tables. Prefer narrower typed values whenever a field has scalar,\ncolor, gradient, duration, scope, or rect semantics.",
      "anyOf": [
        {
          "description": "Explicit null.",
          "type": "null"
        },
        {
          "description": "Boolean leaf value.",
          "type": "boolean"
        },
        {
          "description": "Floating-point numeric leaf value.",
          "type": "number",
          "format": "double"
        },
        {
          "description": "String leaf value.",
          "type": "string"
        },
        {
          "description": "Ordered child values.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredValue"
          }
        },
        {
          "description": "String-keyed object values.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/StructuredValue"
          }
        }
      ]
    },
    "Value": {
      "description": "Canonical tagged literal value used by effect input specs.",
      "oneOf": [
        {
          "description": "Explicit absence of a value.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "null"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Boolean true/false literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "boolean"
            },
            "value": {
              "description": "Boolean payload.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Signed integer literal without a fractional component.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "integer"
            },
            "value": {
              "description": "Integer payload.",
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Floating-point numeric literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "description": "Number payload.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Short machine-facing string literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "string"
            },
            "value": {
              "description": "String payload.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Human-facing text literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "description": "Text payload.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "RGBA color literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color"
            },
            "value": {
              "description": "Color payload.",
              "$ref": "#/$defs/Color"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Gradient stop payload.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "gradient"
            },
            "value": {
              "description": "Gradient payload.",
              "$ref": "#/$defs/GradientSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Duration literal expressed as seconds.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "duration"
            },
            "value": {
              "description": "Duration payload in seconds.",
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Closed-set enum literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "enum"
            },
            "value": {
              "description": "Selected enum value.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Semantic role literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role"
            },
            "value": {
              "description": "Role payload.",
              "$ref": "#/$defs/RoleTag"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Surface scope literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scope"
            },
            "value": {
              "description": "Scope payload.",
              "$ref": "#/$defs/ScopeSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Cell rectangle literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "value": {
              "description": "Rectangle payload.",
              "$ref": "#/$defs/Rect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "description": "Descriptor-owned structured JSON literal.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "structured"
            },
            "value": {
              "description": "Structured JSON payload.",
              "$ref": "#/$defs/StructuredValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    }
  }
}
