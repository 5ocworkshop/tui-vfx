{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectDescriptor",
  "description": "Minimal durable v3.1 effect descriptor contract.",
  "type": "object",
  "properties": {
    "category": {
      "description": "Optional human-facing category label for catalogs and docs.",
      "type": [
        "string",
        "null"
      ]
    },
    "cellAccess": {
      "description": "Cell channels the effect may read or write.",
      "$ref": "#/$defs/CellAccess"
    },
    "displayName": {
      "description": "Human-facing display name.",
      "type": "string"
    },
    "domain": {
      "description": "Broad execution domain for planning and capability grouping.",
      "$ref": "#/$defs/EffectDomain"
    },
    "id": {
      "description": "Stable canonical effect identifier.",
      "$ref": "#/$defs/EffectId"
    },
    "inputs": {
      "description": "Descriptor-local typed input specifications keyed by stable input id.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/EffectInputSpec"
      },
      "propertyNames": {
        "description": "Effect input ids must start with an ASCII letter and then contain only ASCII letters, digits, underscores, or hyphens.",
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "lifecycle": {
      "description": "Minimal lifecycle metadata for planning.",
      "$ref": "#/$defs/EffectLifecycle"
    },
    "outputs": {
      "description": "Descriptor-local typed output specifications keyed by stable output id.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/EffectOutputSpec"
        }
      },
      "propertyNames": {
        "description": "Effect output ids must start with an ASCII letter and then contain only ASCII letters, digits, underscores, or hyphens.",
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      }
    },
    "scopeSupport": {
      "description": "Scope kinds and spaces this effect supports.",
      "$ref": "#/$defs/ScopeSupport"
    },
    "version": {
      "description": "Descriptor version string owned by the effect family.",
      "type": "string"
    },
    "writeSupport": {
      "description": "Cell and role write policies this effect supports.",
      "$ref": "#/$defs/WriteSupport"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "displayName",
    "domain",
    "cellAccess",
    "scopeSupport",
    "writeSupport",
    "inputs",
    "outputs",
    "lifecycle"
  ],
  "$defs": {
    "CellAccess": {
      "description": "Cell channels an effect may read or write.",
      "type": "object",
      "properties": {
        "reads": {
          "description": "Cell channels the effect may inspect.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellChannel"
          }
        },
        "writes": {
          "description": "Cell channels the effect may write.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellChannel"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "reads",
        "writes"
      ]
    },
    "CellChannel": {
      "description": "Canonical channels that make up a cell write.",
      "oneOf": [
        {
          "description": "Glyph character channel.",
          "type": "string",
          "const": "glyph"
        },
        {
          "description": "Foreground color channel.",
          "type": "string",
          "const": "foreground"
        },
        {
          "description": "Background color channel.",
          "type": "string",
          "const": "background"
        },
        {
          "description": "Text modifier channel.",
          "type": "string",
          "const": "modifiers"
        },
        {
          "description": "Modifier alpha channel.",
          "type": "string",
          "const": "modifierAlpha"
        },
        {
          "description": "Semantic role channel. Role writes are governed by role policy.",
          "type": "string",
          "const": "role"
        }
      ]
    },
    "CellWritePolicy": {
      "description": "Policy for how a cell write updates cell channels.",
      "oneOf": [
        {
          "description": "Write the cell exactly, including transparent empty cells.",
          "type": "string",
          "const": "writeCell"
        },
        {
          "description": "Skip only transparent empty cell writes, preserving destination cell and role.",
          "type": "string",
          "const": "skipTransparentEmpty"
        }
      ]
    },
    "Color": {
      "description": "RGBA color with alpha channel for compositing.\n\nUnlike framework-specific color types, this includes an alpha channel\nto enable proper effect layering and transparency.",
      "type": "object",
      "properties": {
        "a": {
          "description": "Alpha channel (0=transparent, 255=opaque)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "b": {
          "description": "Blue channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "description": "Green channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "description": "Red channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "CoordinateSpace": {
      "description": "Coordinate space used by geometry scopes.",
      "oneOf": [
        {
          "description": "Destination-local coordinates. This is the Phase A/B default.",
          "type": "string",
          "const": "destinationLocal"
        },
        {
          "description": "Sampled-source local coordinates. Present to make the contract explicit.",
          "type": "string",
          "const": "sampledSource"
        }
      ]
    },
    "EffectCompletion": {
      "description": "Minimal completion category for descriptor lifecycle metadata.",
      "oneOf": [
        {
          "description": "The effect does not naturally complete on its own.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "The effect completes during the same evaluation step.",
          "type": "string",
          "const": "instant"
        },
        {
          "description": "The effect completes after a bounded duration.",
          "type": "string",
          "const": "timeBound"
        },
        {
          "description": "The effect eventually completes, but the bound is not part of E1.",
          "type": "string",
          "const": "eventual"
        },
        {
          "description": "Completion is controlled by an external host signal.",
          "type": "string",
          "const": "external"
        }
      ]
    },
    "EffectDomain": {
      "description": "Broad execution role declared by an effect descriptor.",
      "oneOf": [
        {
          "description": "Generates content cells without requiring existing source content.",
          "type": "string",
          "const": "contentGenerator"
        },
        {
          "description": "Transforms existing content while preserving its broad semantic role.",
          "type": "string",
          "const": "contentTransform"
        },
        {
          "description": "Shades individual cell visual channels.",
          "type": "string",
          "const": "cellShader"
        },
        {
          "description": "Filters a complete frame or surface after content exists.",
          "type": "string",
          "const": "frameFilter"
        },
        {
          "description": "Changes which source coordinate a destination cell samples.",
          "type": "string",
          "const": "coordinateSampler"
        },
        {
          "description": "Produces or applies a mask for later stages.",
          "type": "string",
          "const": "mask"
        },
        {
          "description": "Produces shadow-like support content or role tagging.",
          "type": "string",
          "const": "shadow"
        },
        {
          "description": "Runs after primary composition as a post-process.",
          "type": "string",
          "const": "postProcess"
        },
        {
          "description": "Emits diagnostics or analysis without being a visual effect.",
          "type": "string",
          "const": "diagnosticTooling"
        }
      ]
    },
    "EffectId": {
      "description": "Stable canonical effect identifier.",
      "type": "string"
    },
    "EffectInputSpec": {
      "description": "Descriptor-local specification for one effect input.",
      "type": "object",
      "properties": {
        "bindable": {
          "description": "Whether later phases may bind this input to a source; no binding model exists in F1.",
          "type": "boolean"
        },
        "description": {
          "description": "Optional human-facing description for documentation and catalogs.",
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "description": "Optional human-facing display name for documentation and catalogs.",
          "type": [
            "string",
            "null"
          ]
        },
        "optional": {
          "description": "Whether this input may be omitted even when it has no value default.",
          "type": "boolean",
          "default": false
        },
        "runtimeMutability": {
          "description": "When this input value may change during the effect lifecycle.",
          "$ref": "#/$defs/RuntimeMutability"
        },
        "value": {
          "description": "Typed value contract, including default, range, enum values, unit, and semantic hints.",
          "$ref": "#/$defs/ValueSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "bindable",
        "runtimeMutability"
      ]
    },
    "EffectLifecycle": {
      "description": "Minimal lifecycle metadata declared by an effect descriptor.",
      "type": "object",
      "properties": {
        "completion": {
          "description": "Completion category exposed to recipe and runtime planning.",
          "$ref": "#/$defs/EffectCompletion"
        },
        "deterministicWithSeed": {
          "description": "Whether seeded execution is deterministic for the same inputs.",
          "type": "boolean"
        },
        "resettable": {
          "description": "Whether the effect can be reset to its initial state.",
          "type": "boolean"
        },
        "seekable": {
          "description": "Whether the effect can be sampled at an arbitrary timeline position.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "completion",
        "resettable",
        "seekable",
        "deterministicWithSeed"
      ]
    },
    "EffectOutputSpec": {
      "description": "Descriptor-local specification for one effect-computed output.",
      "type": "object",
      "properties": {
        "description": {
          "description": "Optional human-facing description for docs and catalogs.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Typed value kind produced by this output.",
          "$ref": "#/$defs/GraphValueKind"
        },
        "shape": {
          "description": "Cardinality of the produced value.",
          "$ref": "#/$defs/GraphValueShape"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "shape"
      ]
    },
    "GradientSpec": {
      "description": "Canonical gradient value for descriptor inputs.",
      "type": "object",
      "properties": {
        "space": {
          "description": "Color interpolation space, such as `rgb` or `hct`.",
          "type": "string"
        },
        "stops": {
          "description": "Ordered or author-provided gradient stops.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GradientStop"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "stops",
        "space"
      ]
    },
    "GradientStop": {
      "description": "One color stop in a canonical gradient value.",
      "type": "object",
      "properties": {
        "color": {
          "description": "Color sampled at this stop.",
          "$ref": "#/$defs/Color"
        },
        "position": {
          "description": "Normalized stop position in the inclusive 0..1 range.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "position",
        "color"
      ]
    },
    "GraphValueKind": {
      "description": "Closed vocabulary for values published on the graph-local value bus.",
      "oneOf": [
        {
          "description": "Floating-point scalar value. Shape decides whether it is frame-wide or per-cell.",
          "type": "string",
          "const": "number"
        }
      ]
    },
    "GraphValueShape": {
      "description": "Cardinality or sampling shape for a graph-local value.",
      "oneOf": [
        {
          "description": "One value applies to the entire frame/node execution.",
          "type": "string",
          "const": "frameValue"
        },
        {
          "description": "Value may vary per destination/sample cell.",
          "type": "string",
          "const": "cellField"
        }
      ]
    },
    "InternedRoleName": {
      "description": "Opaque interned name for a `RoleTag::Custom` variant.\n\nA newtype wrapper around `InternedString` so custom role names are\ndistinct at the type level from other interned identifiers\n(`LayerId`, `RecipeId`). Foreign code can read the inner name via\n`as_str()` but cannot accidentally substitute a `LayerId` for a role\nname or vice versa.",
      "type": "string"
    },
    "NumericRange": {
      "description": "Optional inclusive numeric bounds for a value spec.",
      "type": "object",
      "properties": {
        "max": {
          "description": "Inclusive maximum value when present.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "min": {
          "description": "Inclusive minimum value when present.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Rect": {
      "description": "Rectangle in cell coordinates.\n\nThis is the primary geometry type for defining effect regions.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Rectangle height in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "width": {
          "description": "Rectangle width in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "description": "Left edge x coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "description": "Top edge y coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RoleSpace": {
      "description": "Role source used by role scopes.",
      "oneOf": [
        {
          "description": "Role scopes inspect the sampled source role. This is the Phase A/B default.",
          "type": "string",
          "const": "sampledSource"
        },
        {
          "description": "Role scopes inspect the destination role before the write.",
          "type": "string",
          "const": "destination"
        }
      ]
    },
    "RoleTag": {
      "description": "Per-cell semantic role tag.\n\nTwelve first-class variants cover the common roles. `Custom(name)` covers\nad-hoc recipe-declared roles. `#[non_exhaustive]` preserves room for\nfuture first-class additions without a breaking change.\n\nEvery first-class variant has a stable numeric ID in `RoleInterner`\n(Background=0, Text=1, …, Procedural=11); Custom IDs start at 12.",
      "oneOf": [
        {
          "description": "Fill cells (no glyph or styled space).",
          "type": "string",
          "const": "Background"
        },
        {
          "description": "Primary content text.",
          "type": "string",
          "const": "Text"
        },
        {
          "description": "Title / header text.",
          "type": "string",
          "const": "Title"
        },
        {
          "description": "Secondary / sub text.",
          "type": "string",
          "const": "Caption"
        },
        {
          "description": "Structural / decorative borders.",
          "type": "string",
          "const": "Border"
        },
        {
          "description": "Image / pixel-art / glyph-art cells.",
          "type": "string",
          "const": "Image"
        },
        {
          "description": "Small icon glyphs.",
          "type": "string",
          "const": "Icon"
        },
        {
          "description": "Status / focus / selection markers.",
          "type": "string",
          "const": "Indicator"
        },
        {
          "description": "Emphasized content (search hits, etc.).",
          "type": "string",
          "const": "Highlight"
        },
        {
          "description": "Shadow content — source layer OR pipeline output.",
          "type": "string",
          "const": "Shadow"
        },
        {
          "description": "Ornamental cells (dividers, ornaments).",
          "type": "string",
          "const": "Decoration"
        },
        {
          "description": "Cells produced by a procedural source.",
          "type": "string",
          "const": "Procedural"
        },
        {
          "description": "Author-declared custom role, such as `\"logo_silhouette\"`.",
          "type": "object",
          "properties": {
            "Custom": {
              "description": "Custom role name serialized as a string.",
              "$ref": "#/$defs/InternedRoleName"
            }
          },
          "additionalProperties": false,
          "required": [
            "Custom"
          ]
        }
      ]
    },
    "RoleWritePolicyKind": {
      "description": "Payload-free role write policy kind used by descriptor support declarations.",
      "oneOf": [
        {
          "description": "Descriptor may preserve destination roles.",
          "type": "string",
          "const": "preserveDestination"
        },
        {
          "description": "Descriptor may copy sampled-source roles.",
          "type": "string",
          "const": "copySampledSource"
        },
        {
          "description": "Descriptor may set an explicit role chosen by the operation.",
          "type": "string",
          "const": "setExplicit"
        }
      ]
    },
    "RuntimeMutability": {
      "description": "Vocabulary describing when an effect input may change.",
      "oneOf": [
        {
          "description": "Value is fixed when the effect contract is compiled or instantiated.",
          "type": "string",
          "const": "compileTime"
        },
        {
          "description": "Value may be set at the start of a phase.",
          "type": "string",
          "const": "phaseStart"
        },
        {
          "description": "Value may change only when the effect is reset.",
          "type": "string",
          "const": "resetOnly"
        },
        {
          "description": "Value may change while the effect is running.",
          "type": "string",
          "const": "runtime"
        }
      ]
    },
    "ScopeKind": {
      "description": "Scope shape a descriptor can explicitly support.",
      "oneOf": [
        {
          "description": "Descriptor supports all-cell scopes.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Descriptor supports role-based scopes.",
          "type": "string",
          "const": "role"
        },
        {
          "description": "Descriptor supports rectangular geometry scopes.",
          "type": "string",
          "const": "rect"
        },
        {
          "description": "Descriptor supports row range geometry scopes.",
          "type": "string",
          "const": "rowRange"
        },
        {
          "description": "Descriptor supports column range geometry scopes.",
          "type": "string",
          "const": "columnRange"
        },
        {
          "description": "Descriptor supports row modulo scopes.",
          "type": "string",
          "const": "moduloRows"
        },
        {
          "description": "Descriptor supports column modulo scopes.",
          "type": "string",
          "const": "moduloColumns"
        },
        {
          "description": "Descriptor supports non-empty content scopes.",
          "type": "string",
          "const": "nonEmpty"
        },
        {
          "description": "Descriptor supports the outer perimeter band.",
          "type": "string",
          "const": "outerBand"
        },
        {
          "description": "Descriptor supports cells inside the outer perimeter.",
          "type": "string",
          "const": "inner"
        }
      ]
    },
    "ScopeSpec": {
      "description": "Minimal Phase A/B scope algebra.",
      "oneOf": [
        {
          "description": "Match every in-bounds cell.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells with the requested role in the active role space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role"
            },
            "role": {
              "description": "Role required in the active role space.",
              "$ref": "#/$defs/RoleTag"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "description": "Match a rectangle in the active coordinate space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "rect": {
              "description": "Rectangle to match in the active coordinate space.",
              "$ref": "#/$defs/Rect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rect"
          ]
        },
        {
          "description": "Match rows `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rowRange"
            },
            "start": {
              "description": "Inclusive start row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match columns `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "columnRange"
            },
            "start": {
              "description": "Inclusive start column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match rows where `row % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloRows"
            },
            "modulus": {
              "description": "Positive modulus used to select rows.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match columns where `column % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloColumns"
            },
            "modulus": {
              "description": "Positive modulus used to select columns.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match cells containing non-empty glyph content.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nonEmpty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match the outer perimeter band.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outerBand"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells that are not on the outer perimeter.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inner"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
