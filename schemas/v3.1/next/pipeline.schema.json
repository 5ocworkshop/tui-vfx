{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SurfacePipeline",
  "description": "Ordered multi-stage surface pipeline.",
  "type": "object",
  "properties": {
    "stages": {
      "description": "Ordered stage list. Later stages read the surface produced by earlier stages.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PipelineStage"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "stages"
  ],
  "$defs": {
    "Cell": {
      "description": "A single cell in a terminal display.\n\nEach cell contains a character and its styling information (colors and modifiers).",
      "type": "object",
      "properties": {
        "bg": {
          "description": "Background color.",
          "$ref": "#/$defs/Color"
        },
        "ch": {
          "description": "The character to display.",
          "type": "string",
          "maxLength": 1,
          "minLength": 1
        },
        "fg": {
          "description": "Foreground (text) color.",
          "$ref": "#/$defs/Color"
        },
        "mod_alpha": {
          "description": "Optional alpha override for modifier application (0-255).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "mods": {
          "description": "Text modifiers (bold, italic, etc.).",
          "$ref": "#/$defs/Modifiers"
        }
      },
      "additionalProperties": false,
      "required": [
        "ch",
        "fg",
        "bg",
        "mods"
      ]
    },
    "CellWritePolicy": {
      "description": "Policy for how a cell write updates cell channels.",
      "oneOf": [
        {
          "description": "Write the cell exactly, including transparent empty cells.",
          "type": "string",
          "const": "writeCell"
        },
        {
          "description": "Skip only transparent empty cell writes, preserving destination cell and role.",
          "type": "string",
          "const": "skipTransparentEmpty"
        }
      ]
    },
    "Color": {
      "description": "RGBA color with alpha channel for compositing.\n\nUnlike framework-specific color types, this includes an alpha channel\nto enable proper effect layering and transparency.",
      "type": "object",
      "properties": {
        "a": {
          "description": "Alpha channel (0=transparent, 255=opaque)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "b": {
          "description": "Blue channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "g": {
          "description": "Green channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "r": {
          "description": "Red channel (0-255)",
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "DimEffect": {
      "description": "Visual-only dim effect. It changes color channels and preserves roles.",
      "type": "object",
      "properties": {
        "factor": {
          "description": "Brightness factor applied to foreground and background colors.",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "factor"
      ]
    },
    "ExplicitRoleWriteEffect": {
      "description": "Tiny procedural writer that can explicitly set a destination role.",
      "type": "object",
      "properties": {
        "cell": {
          "description": "Cell to write.",
          "$ref": "#/$defs/Cell"
        },
        "cellPolicy": {
          "description": "Cell write policy.",
          "$ref": "#/$defs/CellWritePolicy"
        },
        "role": {
          "description": "Role to assign to the destination cell.",
          "$ref": "#/$defs/RoleTag"
        }
      },
      "additionalProperties": false,
      "required": [
        "cell",
        "role",
        "cellPolicy"
      ]
    },
    "InternedRoleName": {
      "description": "Opaque interned name for a `RoleTag::Custom` variant.\n\nA newtype wrapper around `InternedString` so custom role names are\ndistinct at the type level from other interned identifiers\n(`LayerId`, `RecipeId`). Foreign code can read the inner name via\n`as_str()` but cannot accidentally substitute a `LayerId` for a role\nname or vice versa.",
      "type": "string"
    },
    "Modifiers": {
      "description": "Text modifiers for terminal display.\n\nThese map to common terminal text attributes supported by most terminals.",
      "type": "object",
      "properties": {
        "bold": {
          "description": "Bold/intense text modifier.",
          "type": "boolean"
        },
        "dim": {
          "description": "Dim/faint text modifier.",
          "type": "boolean"
        },
        "hidden": {
          "description": "Hidden/invisible text (SGR 8). Note: Often disabled for security.",
          "type": "boolean"
        },
        "italic": {
          "description": "Italic text modifier.",
          "type": "boolean"
        },
        "rapid_blink": {
          "description": "Rapid blink (SGR 6). Note: Rarely supported by terminals.",
          "type": "boolean"
        },
        "reverse": {
          "description": "Reverse-video text modifier.",
          "type": "boolean"
        },
        "slow_blink": {
          "description": "Slow blink (SGR 5). Note: Poorly supported by modern terminals.",
          "type": "boolean"
        },
        "strikethrough": {
          "description": "Strikethrough text modifier.",
          "type": "boolean"
        },
        "underline": {
          "description": "Underline text modifier.",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "bold",
        "italic",
        "underline",
        "dim",
        "reverse",
        "strikethrough",
        "slow_blink",
        "rapid_blink",
        "hidden"
      ]
    },
    "PipelineSampler": {
      "description": "Samplers supported by the Phase C toy pipeline stages.",
      "oneOf": [
        {
          "description": "Identity sampling, preserving Phase A behavior.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "identity"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Shift sampling, preserving Phase B behavior inside a pipeline stage.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shift"
            },
            "sampler": {
              "description": "Shift sampler configuration.",
              "$ref": "#/$defs/ShiftSampler"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sampler"
          ]
        }
      ]
    },
    "PipelineStage": {
      "description": "One tiny ordered pipeline stage.",
      "oneOf": [
        {
          "description": "Copy/sample cells and sampled-source roles from the stage read surface.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "copy"
            },
            "name": {
              "description": "Stable stage name used in diagnostics.",
              "type": "string"
            },
            "sampler": {
              "description": "Stage sampler.",
              "$ref": "#/$defs/PipelineSampler"
            },
            "scope": {
              "description": "Stage scope.",
              "$ref": "#/$defs/ScopeSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "scope",
            "sampler"
          ]
        },
        {
          "description": "Visual-only dim stage that preserves destination roles.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "Dim effect.",
              "$ref": "#/$defs/DimEffect"
            },
            "kind": {
              "type": "string",
              "const": "dim"
            },
            "name": {
              "description": "Stable stage name used in diagnostics.",
              "type": "string"
            },
            "scope": {
              "description": "Stage scope.",
              "$ref": "#/$defs/ScopeSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "scope",
            "effect"
          ]
        },
        {
          "description": "Explicit role writer stage.",
          "type": "object",
          "properties": {
            "effect": {
              "description": "Writer effect.",
              "$ref": "#/$defs/ExplicitRoleWriteEffect"
            },
            "kind": {
              "type": "string",
              "const": "explicitRoleWrite"
            },
            "name": {
              "description": "Stable stage name used in diagnostics.",
              "type": "string"
            },
            "scope": {
              "description": "Stage scope.",
              "$ref": "#/$defs/ScopeSpec"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "scope",
            "effect"
          ]
        },
        {
          "description": "Test-helper glyph rewrite stage scoped by the stage read surface.",
          "type": "object",
          "properties": {
            "from": {
              "description": "Glyph to replace.",
              "type": "string",
              "maxLength": 1,
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "const": "replaceGlyph"
            },
            "name": {
              "description": "Stable stage name used in diagnostics.",
              "type": "string"
            },
            "scope": {
              "description": "Stage scope.",
              "$ref": "#/$defs/ScopeSpec"
            },
            "to": {
              "description": "Replacement glyph.",
              "type": "string",
              "maxLength": 1,
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "scope",
            "from",
            "to"
          ]
        }
      ]
    },
    "Rect": {
      "description": "Rectangle in cell coordinates.\n\nThis is the primary geometry type for defining effect regions.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Rectangle height in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "width": {
          "description": "Rectangle width in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "x": {
          "description": "Left edge x coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "y": {
          "description": "Top edge y coordinate in cells.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "RoleTag": {
      "description": "Per-cell semantic role tag.\n\nTwelve first-class variants cover the common roles. `Custom(name)` covers\nad-hoc recipe-declared roles. `#[non_exhaustive]` preserves room for\nfuture first-class additions without a breaking change.\n\nEvery first-class variant has a stable numeric ID in `RoleInterner`\n(Background=0, Text=1, …, Procedural=11); Custom IDs start at 12.",
      "oneOf": [
        {
          "description": "Fill cells (no glyph or styled space).",
          "type": "string",
          "const": "Background"
        },
        {
          "description": "Primary content text.",
          "type": "string",
          "const": "Text"
        },
        {
          "description": "Title / header text.",
          "type": "string",
          "const": "Title"
        },
        {
          "description": "Secondary / sub text.",
          "type": "string",
          "const": "Caption"
        },
        {
          "description": "Structural / decorative borders.",
          "type": "string",
          "const": "Border"
        },
        {
          "description": "Image / pixel-art / glyph-art cells.",
          "type": "string",
          "const": "Image"
        },
        {
          "description": "Small icon glyphs.",
          "type": "string",
          "const": "Icon"
        },
        {
          "description": "Status / focus / selection markers.",
          "type": "string",
          "const": "Indicator"
        },
        {
          "description": "Emphasized content (search hits, etc.).",
          "type": "string",
          "const": "Highlight"
        },
        {
          "description": "Shadow content — source layer OR pipeline output.",
          "type": "string",
          "const": "Shadow"
        },
        {
          "description": "Ornamental cells (dividers, ornaments).",
          "type": "string",
          "const": "Decoration"
        },
        {
          "description": "Cells produced by a procedural source.",
          "type": "string",
          "const": "Procedural"
        },
        {
          "description": "Author-declared custom role, such as `\"logo_silhouette\"`.",
          "type": "object",
          "properties": {
            "Custom": {
              "description": "Custom role name serialized as a string.",
              "$ref": "#/$defs/InternedRoleName"
            }
          },
          "additionalProperties": false,
          "required": [
            "Custom"
          ]
        }
      ]
    },
    "ScopeSpec": {
      "description": "Minimal Phase A/B scope algebra.",
      "oneOf": [
        {
          "description": "Match every in-bounds cell.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells with the requested role in the active role space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "role"
            },
            "role": {
              "description": "Role required in the active role space.",
              "$ref": "#/$defs/RoleTag"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ]
        },
        {
          "description": "Match a rectangle in the active coordinate space.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "rect"
            },
            "rect": {
              "description": "Rectangle to match in the active coordinate space.",
              "$ref": "#/$defs/Rect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rect"
          ]
        },
        {
          "description": "Match rows `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "rowRange"
            },
            "start": {
              "description": "Inclusive start row in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match columns `[start, end)` in the active coordinate space.",
          "type": "object",
          "properties": {
            "end": {
              "description": "Exclusive end column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "columnRange"
            },
            "start": {
              "description": "Inclusive start column in the active coordinate space.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "end"
          ]
        },
        {
          "description": "Match rows where `row % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloRows"
            },
            "modulus": {
              "description": "Positive modulus used to select rows.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match columns where `column % modulus == remainder`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "moduloColumns"
            },
            "modulus": {
              "description": "Positive modulus used to select columns.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "remainder": {
              "description": "Remainder selected by the modulo expression.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "modulus",
            "remainder"
          ]
        },
        {
          "description": "Match cells containing non-empty glyph content.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "nonEmpty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match the outer perimeter band.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "outerBand"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Match cells that are not on the outer perimeter.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "inner"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ShiftSampler": {
      "description": "Shift sampler: destination `(x, y)` samples source `(x + dx, y + dy)`.\n\nPositive `dx` samples from a source cell to the right of the destination;\npositive `dy` samples from a source cell below the destination. Coordinates\nshifted outside the source surface return `None` and skip the write.",
      "type": "object",
      "properties": {
        "dx": {
          "description": "Horizontal source offset relative to the destination coordinate.",
          "type": "integer",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768
        },
        "dy": {
          "description": "Vertical source offset relative to the destination coordinate.",
          "type": "integer",
          "format": "int16",
          "maximum": 32767,
          "minimum": -32768
        }
      },
      "additionalProperties": false,
      "required": [
        "dx",
        "dy"
      ]
    }
  }
}
