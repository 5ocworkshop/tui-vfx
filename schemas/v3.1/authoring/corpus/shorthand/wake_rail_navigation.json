{
  "id": "wake-rail-navigation",
  "title": "Wake-Rail Navigation",
  "at": "left",
  "card": {
    "message": "▎ Inbox\n▎ Drafts\n▎ Sent\n▎ Archive\n▎ Spam\n▎ Trash\n  ◌      ◌      ◌",
    "size": [26, 9],
    "fg": [222, 230, 244],
    "bg": [16, 20, 28],
    "border": { "type": "rounded", "title": "Mail", "titleAlign": "left" }
  },
  "bindings": {
    "selectedRow": { "type": "number", "range": [0, 8], "default": 3, "loopback": { "type": "ramp", "start": 0, "end": 8, "duration": "5s" } },
    "hoverProgress": { "type": "number", "range": [0, 1], "default": 0.6, "loopback": { "type": "ramp", "start": 0, "end": 1, "duration": "2s" } },
    "wayfindingIndex": { "type": "number", "range": [0, 2], "default": 1, "loopback": { "type": "ramp", "start": 0, "end": 2, "duration": "4s" } }
  },
  "effects": [
    {
      "shader": "affordance_wake",
      "scope": { "channel": "background" },
      "color": [200, 220, 255],
      "zone": "allEdges",
      "radius": 2,
      "progress": "$bind:hoverProgress",
      "peakIntensity": 0.22
    },
    {
      "shader": "focused_row_gradient",
      "scope": { "rowRange": [1, 7] },
      "brightColor": [110, 175, 240],
      "dimColor": [16, 20, 28],
      "selectedRow": "$bind:selectedRow",
      "falloffDistance": 2
    },
    {
      "filter": "edge_grow",
      "scope": { "rect": [1, 1, 1, 6] },
      "restEighths": 1,
      "peakEighths": 8,
      "edge": "left",
      "fillColor": [120, 200, 255],
      "bgColor": [16, 20, 28],
      "progress": "$bind:hoverProgress"
    },
    {
      "shader": "wayfinding_node",
      "scope": { "rows": [7] },
      "color": [200, 230, 255],
      "nodes": [[4, 7], [12, 7], [20, 7]],
      "radius": 2,
      "intensity": 0.32,
      "currentIndex": "$bind:wayfindingIndex",
      "previousStrength": 0.45,
      "futureStrength": 0.10,
      "pulseSpeed": 0.4
    }
  ]
}
