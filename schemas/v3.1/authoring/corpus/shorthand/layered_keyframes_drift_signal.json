{
  "id": "signal-layered-keyframes",
  "title": "Signal: Layered Keyframes Drift",
  "loop": "1.8s",
  "card": {
    "message": "Pattern 5 - add keyframes noise",
    "size": [40, 3],
    "fg": [220, 220, 240],
    "bg": [20, 20, 30],
    "border": "rounded"
  },
  "bindings": {
    "demoDrift": {
      "type": "f32",
      "loopback": {
        "type": "add",
        "a": { "type": "keyframes", "points": [[0.0, 0.3], [0.4, 1.2], [0.7, 0.6], [1.0, 0.9]] },
        "b": { "type": "spatial_noise", "seed": 42, "frequency": 1.0, "amplitude": 0.05 }
      }
    }
  },
  "effects": [
    {
      "filter": "rigid_shake",
      "phase": "dwell",
      "shakePeriod": 0.29,
      "numShakes": 4,
      "pauseDuration": 0.52,
      "dampingScale": "$bind:demoDrift"
    }
  ]
}
