{
  "id": "alarm-lighthouse",
  "title": "Alarm Lighthouse",
  "loop": "2.4s",
  "card": {
    "message": "PANIC BEACON // HOLD",
    "size": [44, 7],
    "fg": [210, 235, 255],
    "bg": [14, 18, 34],
    "border": "rounded"
  },
  "transitions": {
    "enter": { "preset": "radial", "origin": "center", "softEdge": true, "duration": "1.2s" },
    "exit":  { "preset": "radial", "origin": "topRight", "softEdge": false, "duration": "900ms" }
  },
  "effects": [
    {
      "filter": "kitt_scanner",
      "phase": "dwell",
      "boost": 135,
      "bandWidth": 0.28,
      "bps": 1.0,
      "progress": 1.0,
      "motionMode": "forwardWrap",
      "applyTo": "background"
    },
    {
      "shader": "glow",
      "color": [255, 108, 72],
      "radius": 3,
      "falloff": "quadratic",
      "intensity": 0.75,
      "pulseSpeed": 0.7
    },
    {
      "shader": "pulse",
      "phase": "dwell",
      "frequency": 1.2,
      "pulseColor": [255, 118, 84]
    },
    { "filter": "dim", "phase": "exit", "factor": 0.35, "applyTo": "both" }
  ]
}
