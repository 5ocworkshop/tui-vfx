{
  "id": "coin-get",
  "version": "3.1",
  "metadata": {
    "title": "Coin Get",
    "description": "Bouncing coin notification with fg-only fade and reflective sheen on text region.",
    "authors": ["corpus"],
    "tags": ["transition", "bounce", "region-targeting", "spatial-shader"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 1000 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 1500 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 650 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "+500 GOLD" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 16 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 3 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 255, "g": 215, "b": 0, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 0, "g": 0, "b": 0, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } }
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "reflect": {
        "id": "reflect",
        "effect": "shader.reflect",
        "inputs": {
          "speed": { "kind": "literal", "value": { "kind": "number", "value": 3.0 } },
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 255, "g": 255, "b": 255, "a": 255 } } }
        },
        "scope": { "kind": "content", "value": "text" }
      }
    },
    "order": ["reflect"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 16,
      "height": 3,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "placementRule": {
            "kind": "anchor",
            "anchor": "bottomRight",
            "offsetRows": 0,
            "offsetColumns": 0
          },
          "placementMotion": {
            "enter": {
              "duration": { "kind": "milliseconds", "value": 1000 },
              "easing": { "kind": "named", "value": "quadOut" },
              "route": { "kind": "bounce", "bounces": 4, "decay": 0.5 },
              "from": { "kind": "offscreen", "direction": "fromTop", "marginCells": 1 },
              "snap": { "kind": "round" }
            },
            "exit": {
              "duration": { "kind": "milliseconds", "value": 650 },
              "easing": { "kind": "named", "value": "quadIn" },
              "route": { "kind": "linear" },
              "to": { "kind": "offscreen", "direction": "fromBottom", "marginCells": 1 },
              "snap": { "kind": "round" }
            }
          },
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
