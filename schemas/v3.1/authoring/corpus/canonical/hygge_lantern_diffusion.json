{
  "id": "hygge-lantern-diffusion",
  "version": "3.1",
  "metadata": {
    "title": "Hygge Lantern Diffusion (subtle light study)",
    "description": "Subcell_light dwell filter, breath-mode diffusion shader, concealed_light shader scoped to background; multi-scope style stack.",
    "authors": ["corpus"],
    "tags": ["light", "diffusion", "subcell", "atmospheric", "multi-scope"]
  },
  "lifecycle": {
    "clock": { "mode": "looping", "period": { "kind": "milliseconds", "value": 4600 } },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 460 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 7200 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 340 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Quiet hours\nLamp mode active" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 46 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 7 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 236, "g": 226, "b": 208, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 54, "g": 44, "b": 38, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } },
        "borderTitle": { "kind": "literal", "value": { "kind": "text", "value": " Hygge " } },
        "borderTitleAlignment": { "kind": "literal", "value": { "kind": "enum", "value": "left" } }
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "subcellLight": {
        "id": "subcellLight",
        "effect": "filter.subcell_light",
        "inputs": {
          "litColor": { "kind": "literal", "value": { "kind": "color", "value": { "r": 242, "g": 222, "b": 196, "a": 255 } } },
          "unlitColor": { "kind": "literal", "value": { "kind": "color", "value": { "r": 54, "g": 44, "b": 38, "a": 255 } } },
          "renderMode": { "kind": "literal", "value": { "kind": "enum", "value": "braille" } },
          "sampleFrom": { "kind": "literal", "value": { "kind": "enum", "value": "background" } },
          "threshold": { "kind": "literal", "value": { "kind": "number", "value": 0.05 } },
          "temporalDitherHz": { "kind": "literal", "value": { "kind": "number", "value": 1.0 } },
          "onlyBlank": { "kind": "literal", "value": { "kind": "boolean", "value": true } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["dwell"]
      },
      "diffusionBg": {
        "id": "diffusionBg",
        "effect": "shader.diffusion",
        "inputs": {
          "source": { "kind": "literal", "value": { "kind": "enum", "value": "topLeft" } },
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 242, "g": 222, "b": 196, "a": 255 } } },
          "radius": { "kind": "literal", "value": { "kind": "integer", "value": 9 } },
          "softness": { "kind": "literal", "value": { "kind": "number", "value": 0.88 } },
          "edgeFirmness": { "kind": "literal", "value": { "kind": "number", "value": 0.22 } },
          "intensity": { "kind": "literal", "value": { "kind": "number", "value": 0.22 } },
          "mode": { "kind": "literal", "value": { "kind": "enum", "value": "breath" } },
          "driftSpeed": { "kind": "literal", "value": { "kind": "number", "value": 0.32 } },
          "driftAmount": { "kind": "literal", "value": { "kind": "number", "value": 0.05 } },
          "applyTo": { "kind": "literal", "value": { "kind": "enum", "value": "background" } }
        },
        "scope": { "kind": "channel", "value": "background" }
      },
      "concealedLightBg": {
        "id": "concealedLightBg",
        "effect": "shader.concealed_light",
        "inputs": {
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 236, "g": 210, "b": 176, "a": 255 } } },
          "source": { "kind": "literal", "value": { "kind": "enum", "value": "top" } },
          "spread": { "kind": "literal", "value": { "kind": "number", "value": 5.0 } },
          "edgeWidth": { "kind": "literal", "value": { "kind": "integer", "value": 1 } },
          "sourceCutoff": { "kind": "literal", "value": { "kind": "number", "value": 0.18 } },
          "intensity": { "kind": "literal", "value": { "kind": "number", "value": 0.12 } },
          "applyTo": { "kind": "literal", "value": { "kind": "enum", "value": "background" } }
        },
        "scope": { "kind": "channel", "value": "background" }
      }
    },
    "order": ["subcellLight", "diffusionBg", "concealedLightBg"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 46,
      "height": 7,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
