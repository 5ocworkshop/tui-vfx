{
  "id": "style-color-fade",
  "version": "3.1",
  "metadata": {
    "title": "Style: Color Fade (phase-differentiated color spaces)",
    "description": "RGB-space fade on enter to warm orange; HSL-space fade on exit to dark indigo.",
    "authors": ["corpus"],
    "tags": ["style", "color-fade", "color-space"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 1000 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 3000 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 1000 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Style: Color Fade" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 39 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 3 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 255, "g": 255, "b": 255, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 60, "g": 20, "b": 80, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } }
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "fadeRgb": {
        "id": "fadeRgb",
        "effect": "style.color_fade",
        "inputs": {
          "colorSpace": { "kind": "literal", "value": { "kind": "enum", "value": "rgb" } },
          "target": { "kind": "literal", "value": { "kind": "color", "value": { "r": 255, "g": 200, "b": 50, "a": 255 } } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["enter"]
      },
      "fadeHsl": {
        "id": "fadeHsl",
        "effect": "style.color_fade",
        "inputs": {
          "colorSpace": { "kind": "literal", "value": { "kind": "enum", "value": "hsl" } },
          "target": { "kind": "literal", "value": { "kind": "color", "value": { "r": 50, "g": 50, "b": 100, "a": 255 } } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["exit"]
      }
    },
    "order": ["fadeRgb", "fadeHsl"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 39,
      "height": 3,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
