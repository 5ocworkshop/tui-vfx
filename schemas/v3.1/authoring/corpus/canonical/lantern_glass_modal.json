{
  "id": "lantern-glass-modal",
  "version": "3.1",
  "metadata": {
    "title": "Lantern-Glass Modal",
    "description": "Premium frosted modal: concealed_light + diffusion + subcell_light + edge_shadow overlay + bevel + gradient shadow.",
    "authors": ["corpus"],
    "tags": ["modal", "premium", "multi-shader", "frosted", "architectural"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 260 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 6000 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 180 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Lantern-Glass Modal\nFrosted shell · soft inner light\nPress Enter to confirm" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 46 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 7 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 232, "g": 238, "b": 248, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 22, "g": 28, "b": 40, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } },
        "borderTitle": { "kind": "literal", "value": { "kind": "text", "value": "Modal" } },
        "borderTitleAlignment": { "kind": "literal", "value": { "kind": "enum", "value": "center" } }
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "concealedLight": {
        "id": "concealedLight",
        "effect": "shader.concealed_light",
        "inputs": {
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 236, "g": 220, "b": 188, "a": 255 } } },
          "source": { "kind": "literal", "value": { "kind": "enum", "value": "left" } },
          "spread": { "kind": "literal", "value": { "kind": "number", "value": 6.0 } },
          "edgeWidth": { "kind": "literal", "value": { "kind": "integer", "value": 1 } },
          "sourceCutoff": { "kind": "literal", "value": { "kind": "number", "value": 0.18 } },
          "intensity": { "kind": "literal", "value": { "kind": "number", "value": 0.30 } }
        },
        "scope": { "kind": "channel", "value": "background" }
      },
      "diffusion": {
        "id": "diffusion",
        "effect": "shader.diffusion",
        "inputs": {
          "source": { "kind": "literal", "value": { "kind": "enum", "value": "center" } },
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 200, "g": 220, "b": 245, "a": 255 } } },
          "radius": { "kind": "literal", "value": { "kind": "integer", "value": 8 } },
          "applyTo": { "kind": "literal", "value": { "kind": "enum", "value": "background" } }
        },
        "scope": { "kind": "all" }
      },
      "subcellLight": {
        "id": "subcellLight",
        "effect": "filter.subcell_light",
        "inputs": {
          "litColor": { "kind": "literal", "value": { "kind": "color", "value": { "r": 220, "g": 232, "b": 250, "a": 255 } } },
          "unlitColor": { "kind": "literal", "value": { "kind": "color", "value": { "r": 28, "g": 34, "b": 48, "a": 255 } } },
          "renderMode": { "kind": "literal", "value": { "kind": "enum", "value": "horizontal" } },
          "sampleFrom": { "kind": "literal", "value": { "kind": "enum", "value": "background" } },
          "threshold": { "kind": "literal", "value": { "kind": "number", "value": 0.05 } },
          "onlyBlank": { "kind": "literal", "value": { "kind": "boolean", "value": true } }
        },
        "scope": { "kind": "all" }
      },
      "edgeShadow": {
        "id": "edgeShadow",
        "effect": "shader.colored_overlay",
        "inputs": {
          "pattern": { "kind": "literal", "value": { "kind": "structured", "value": { "kind": "edge_shadow", "edges": ["bottom", "right"], "radius": 3, "falloff": "quadratic" } } },
          "color": { "kind": "literal", "value": { "kind": "color", "value": { "r": 0, "g": 0, "b": 0, "a": 255 } } },
          "intensity": { "kind": "literal", "value": { "kind": "number", "value": 0.55 } }
        },
        "scope": { "kind": "all" }
      },
      "bevel": {
        "id": "bevel",
        "effect": "shader.bevel",
        "inputs": {
          "lightDirection": { "kind": "literal", "value": { "kind": "enum", "value": "topLeft" } },
          "highlightIntensity": { "kind": "literal", "value": { "kind": "number", "value": 0.22 } },
          "shadowIntensity": { "kind": "literal", "value": { "kind": "number", "value": 0.28 } },
          "edgeWidth": { "kind": "literal", "value": { "kind": "integer", "value": 1 } }
        },
        "scope": { "kind": "channel", "value": "background" }
      }
    },
    "order": ["concealedLight", "diffusion", "subcellLight", "edgeShadow", "bevel"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 46,
      "height": 7,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "surface": {
            "shadow": {
              "color": { "r": 0, "g": 0, "b": 0, "a": 170 },
              "offsetX": 3,
              "offsetY": 2,
              "edges": ["right", "bottom"],
              "softEdges": true,
              "sourceRegion": "border",
              "compositeMode": "glyphOverlay",
              "style": { "kind": "gradient", "layers": 4 }
            }
          },
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
