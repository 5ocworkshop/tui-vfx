{
  "id": "chamfered-corners",
  "version": "3.1",
  "metadata": {
    "title": "Chamfered Corners Demo",
    "description": "Custom border frame with diagonal triangle blocks for cut-corner appearance.",
    "authors": ["corpus"],
    "tags": ["border-frame", "custom-glyphs"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 500 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 5000 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 350 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Corners clipped" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 24 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 4 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 70, "g": 130, "b": 180, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 20, "g": 30, "b": 50, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "custom" } },
        "borderFrame": { "kind": "literal", "value": { "kind": "structured", "value": {
          "topLeft": "◢", "topRight": "◣", "bottomLeft": "◥", "bottomRight": "◤",
          "top": "▀", "bottom": "▄", "left": "█", "right": "█"
        }}}
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "wipeEnter": {
        "id": "wipeEnter",
        "effect": "mask.wipe",
        "inputs": {
          "direction": { "kind": "literal", "value": { "kind": "enum", "value": "leftToRight" } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["enter"]
      }
    },
    "order": ["wipeEnter"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 80,
      "height": 24,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 56, "y": 0 },
          "source": "mainCard",
          "placementRule": {
            "kind": "anchor",
            "anchor": "topRight",
            "offsetRows": 0,
            "offsetColumns": 0
          },
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
