{
  "id": "mask-iris",
  "version": "3.1",
  "metadata": {
    "title": "Mask: Iris",
    "description": "Circle iris on enter, diamond iris on exit.",
    "authors": ["corpus"],
    "tags": ["mask", "iris", "transition-eligible"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 2000 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 4000 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 1000 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Mask: Iris Effect" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 35 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 5 } },
        "foreground": { "kind": "literal", "value": { "kind": "color", "value": { "r": 255, "g": 255, "b": 255, "a": 255 } } },
        "background": { "kind": "literal", "value": { "kind": "color", "value": { "r": 60, "g": 30, "b": 10, "a": 255 } } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } }
      },
      "assets": {}
    }
  },
  "graph": {
    "id": "mainGraph",
    "version": "3.1",
    "nodes": {
      "irisEnter": {
        "id": "irisEnter",
        "effect": "mask.iris",
        "inputs": {
          "shape": { "kind": "literal", "value": { "kind": "enum", "value": "circle" } },
          "softEdge": { "kind": "literal", "value": { "kind": "boolean", "value": true } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["enter"]
      },
      "irisExit": {
        "id": "irisExit",
        "effect": "mask.iris",
        "inputs": {
          "shape": { "kind": "literal", "value": { "kind": "enum", "value": "diamond" } },
          "softEdge": { "kind": "literal", "value": { "kind": "boolean", "value": true } }
        },
        "scope": { "kind": "all" },
        "activePhases": ["exit"]
      }
    },
    "order": ["irisEnter", "irisExit"]
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 35,
      "height": 5,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "pipeline": { "graph": "mainGraph" },
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
