{
  "id": "transition-morph",
  "version": "3.1",
  "metadata": {
    "title": "Transition: Morph (relation.* — schema-faith demonstrator)",
    "description": "Forward-looking: relation.morph animates content correspondence between prior and next text. Distinct from content.morph (single-subject character mutation).",
    "authors": ["corpus"],
    "tags": ["transition", "morph", "relation", "schema-faith"]
  },
  "lifecycle": {
    "clock": { "mode": "monotonic", "period": null },
    "phases": [
      { "phase": "enter", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 600 } } },
      { "phase": "dwell", "timing": { "kind": "dwell", "policy": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 4000 } } } },
      { "phase": "exit", "timing": { "kind": "fixed", "duration": { "kind": "milliseconds", "value": 400 } } }
    ]
  },
  "assets": {},
  "sourceDescriptors": {},
  "sources": {
    "mainCard": {
      "source": "source.card",
      "inputs": {
        "message": { "kind": "literal", "value": { "kind": "text", "value": "Morphed — relation.morph demonstrator" } },
        "width": { "kind": "literal", "value": { "kind": "integer", "value": 40 } },
        "height": { "kind": "literal", "value": { "kind": "integer", "value": 3 } },
        "borderStyle": { "kind": "literal", "value": { "kind": "enum", "value": "rounded" } }
      },
      "assets": {}
    }
  },
  "graph": { "id": "mainGraph", "version": "3.1" },
  "transitions": {
    "enterMorph": {
      "id": "enterMorph",
      "intent": { "kind": "preset", "preset": "morph" },
      "subjects": {
        "from": { "kind": "previous" },
        "to": { "kind": "scene", "id": "mainScene" }
      },
      "timing": {
        "duration": { "kind": "milliseconds", "value": 600 },
        "easing": { "kind": "named", "value": "cubicInOut" }
      },
      "activePhases": ["enter"],
      "tracks": [
        {
          "kind": "relation.morph",
          "from": "from",
          "to": "to",
          "match": "glyph",
          "unmatchedPolicy": "fade"
        }
      ],
      "interruption": "snapToEnd",
      "reducedMotion": { "policy": "substitute", "transition": "enterCrossfade" }
    }
  },
  "scenes": [
    {
      "id": "mainScene",
      "width": 40,
      "height": 3,
      "elements": [
        {
          "id": "mainElement",
          "layer": "primary",
          "zIndex": 0,
          "placement": { "x": 0, "y": 0 },
          "source": "mainCard",
          "clipPolicy": "clip",
          "cellWritePolicy": "writeCell",
          "roleWritePolicy": { "kind": "preserveDestination" }
        }
      ]
    }
  ],
  "descriptorPacks": [{ "id": "v3.1.primitive" }]
}
