{
  "$schema": "../meta/alias-table.schema.json",
  "version": "0.1",
  "axis": "shader",
  "description": "Shader aliases. Author-side { shader: '<name>', ... } in an effects[] entry maps to a graph node with effect: 'shader.<canonical>'. Most shader params pass through with the same name; defaultParams covers params with frequently-omitted defaults. Seed entries; expand with full corpus coverage as the canonicalize function lands.",

  "aliases": [
    {
      "from": "focused_row_gradient",
      "canonicalEffect": "shader.focusedRowGradient",
      "applyToIsInput": true,
      "paramMapping": {
        "selectedRow":     { "to": "selectedRow",     "envelope": "value-source" },
        "falloffDistance": { "to": "falloffDistance", "envelope": "literal-integer", "default": 16 },
        "brightColor":     { "to": "brightColor",     "envelope": "literal-color",   "default": [255, 255, 255] },
        "dimColor":        { "to": "dimColor",        "envelope": "literal-color" },
        "applyTo":         { "to": "applyTo",         "envelope": "literal-enum",    "default": "both" },
        "phase":           { "to": "activePhases",    "envelope": "phases-list" },
        "scope":           { "to": "scope",           "envelope": "scope-spec" }
      },
      "notes": "applyToIsInput: descriptor declares applyTo as a per-effect input that selects which channel the computed gradient color targets. Confirmed against corpus canonical/btop_focused_row_live_list.json."
    },
    {
      "from": "pulse",
      "canonicalEffect": "shader.pulse",
      "paramMapping": {
        "frequency":  { "to": "frequency",  "envelope": "literal-number", "default": 1.0 },
        "color":      { "to": "color",      "envelope": "literal-color" },
        "pulseColor": { "to": "pulseColor", "envelope": "literal-color" },
        "phase":      { "to": "activePhases", "envelope": "phases-list" },
        "scope":      { "to": "scope",        "envelope": "scope-spec" }
      }
    },
    {
      "from": "trace_path",
      "canonicalEffect": "shader.tracePath",
      "paramMapping": {
        "color":          { "to": "color",          "envelope": "literal-color" },
        "speed":          { "to": "speed",          "envelope": "literal-number", "default": 1.0 },
        "tailLength":     { "to": "tailLength",     "envelope": "literal-integer" },
        "verticalWeight": { "to": "verticalWeight", "envelope": "literal-number" },
        "junctionGlow":   { "to": "junctionGlow",   "envelope": "literal-number" },
        "tailMode":       { "to": "tailMode",       "envelope": "literal-enum",    "default": "segment" },
        "applyTo":        { "to": "applyTo",        "envelope": "literal-enum",    "default": "background" },
        "paths":          { "to": "paths",          "envelope": "passthrough" },
        "phase":          { "to": "activePhases",   "envelope": "phases-list" },
        "scope":          { "to": "scope",          "envelope": "scope-spec" }
      },
      "notes": "Polyline geometry stays private (Q12). The 'paths' field passes through; canonicalizer does not reshape it."
    },
    {
      "from": "border_sweep",
      "canonicalEffect": "shader.borderSweep",
      "paramMapping": {
        "speed":  { "to": "loopsPerSecond", "envelope": "literal-number", "default": 0.5 },
        "length": { "to": "length",         "envelope": "literal-integer" },
        "color":  { "to": "sweepColor",     "envelope": "literal-color" },
        "phase":  { "to": "activePhases",   "envelope": "phases-list" },
        "scope":  { "to": "scope",          "envelope": "scope-spec" }
      },
      "scopeRules": {
        "default": { "kind": "role", "value": "border" }
      },
      "notes": "Author-friendly `speed`/`color` map to descriptor inputs `loopsPerSecond`/`sweepColor`."
    },
    {
      "from": "radar",
      "canonicalEffect": "shader.radar",
      "paramMapping": {
        "color":      { "to": "color",      "envelope": "literal-color" },
        "speed":      { "to": "speed",      "envelope": "literal-number" },
        "tailLength": { "to": "tailLength", "envelope": "literal-number" },
        "phase":      { "to": "activePhases", "envelope": "phases-list" },
        "scope":      { "to": "scope",        "envelope": "scope-spec" }
      }
    },
    {
      "from": "wayfinding_node",
      "canonicalEffect": "shader.wayfindingNode",
      "paramMapping": {
        "nodes":        { "to": "nodes",        "envelope": "passthrough" },
        "currentIndex": { "to": "currentIndex", "envelope": "value-source" },
        "color":        { "to": "color",        "envelope": "literal-color" },
        "phase":        { "to": "activePhases", "envelope": "phases-list" },
        "scope":        { "to": "scope",        "envelope": "scope-spec" }
      },
      "notes": "Node-set geometry stays private (Q12). Distinct from trace_path's polyline shape."
    },
    {
      "from": "reflect",
      "canonicalEffect": "shader.reflect",
      "paramMapping": {
        "color": { "to": "reflectionColor", "envelope": "literal-color" },
        "rate":  { "to": "reflectionRate",  "envelope": "literal-number" },
        "speed": { "to": "reflectionRate",  "envelope": "literal-number" },
        "phase": { "to": "activePhases",    "envelope": "phases-list" },
        "scope": { "to": "scope",           "envelope": "scope-spec" }
      },
      "notes": "Author-friendly `color` maps to `reflectionColor`. Both `rate` and `speed` map to `reflectionRate` (synonyms)."
    },
    {
      "from": "highlighter",
      "canonicalEffect": "shader.highlighter",
      "paramMapping": {
        "color": { "to": "highlightColor", "envelope": "literal-color" },
        "phase": { "to": "activePhases",   "envelope": "phases-list" },
        "scope": { "to": "scope",          "envelope": "scope-spec" }
      },
      "notes": "Author-friendly `color` maps to the descriptor input `highlightColor`. Other highlighter inputs (bandWidth, sweepDirection, etc.) pass through verbatim."
    },
    {
      "from": "glow",
      "canonicalEffect": "shader.glow"
    },
    {
      "from": "diffusion",
      "canonicalEffect": "shader.diffusion"
    },
    {
      "from": "edge_sheen",
      "canonicalEffect": "shader.edgeSheen",
      "paramMapping": {
        "color":       { "to": "sheenColor", "envelope": "literal-color" },
        "speed":       { "to": "sheenRate",  "envelope": "literal-number" },
        "bandWidth":   { "to": "bandWidth",  "envelope": "literal-integer" },
        "edgeWidth":   { "to": "edgeWidth",  "envelope": "literal-integer" },
        "intensity":   { "to": "intensity",  "envelope": "literal-number" },
        "cornerBoost": { "to": "cornerBoost", "envelope": "literal-number" },
        "phase":       { "to": "activePhases", "envelope": "phases-list" },
        "scope":       { "to": "scope",        "envelope": "scope-spec" }
      },
      "notes": "Author-friendly `color`/`speed` map to descriptor inputs `sheenColor`/`sheenRate`."
    },
    {
      "from": "concealed_light",
      "canonicalEffect": "shader.concealedLight",
      "paramMapping": {
        "color":        { "to": "lightColor",   "envelope": "literal-color" },
        "source":       { "to": "lightSource",  "envelope": "passthrough" },
        "edgeWidth":    { "to": "edgeWidth",    "envelope": "literal-integer" },
        "intensity":    { "to": "intensity",    "envelope": "literal-number" },
        "sourceCutoff": { "to": "sourceCutoff", "envelope": "literal-number" },
        "spread":       { "to": "spread",       "envelope": "literal-number" },
        "phase":        { "to": "activePhases", "envelope": "phases-list" },
        "scope":        { "to": "scope",        "envelope": "scope-spec" }
      },
      "notes": "Author-friendly `color`/`source` map to descriptor inputs `lightColor`/`lightSource`."
    },
    {
      "from": "affordance_wake",
      "canonicalEffect": "shader.affordanceWake",
      "paramMapping": {
        "color":         { "to": "wakeColor",    "envelope": "literal-color" },
        "progress":      { "to": "wakeProgress", "envelope": "value-source" },
        "peakIntensity": { "to": "peakIntensity", "envelope": "literal-number" },
        "radius":        { "to": "radius",        "envelope": "literal-integer" },
        "zone":          { "to": "zone",          "envelope": "passthrough" },
        "phase":         { "to": "activePhases",  "envelope": "phases-list" },
        "scope":         { "to": "scope",         "envelope": "scope-spec" }
      },
      "notes": "Author-friendly `color`/`progress` map to descriptor inputs `wakeColor`/`wakeProgress`."
    },
    {
      "from": "glisten_band",
      "canonicalEffect": "shader.glistenBand",
      "notes": "Shader-axis glisten band (mid-century). Distinct from style.glistenBand; the corpus uses the shader form for the marquee-style sweep."
    },
    {
      "from": "linear_gradient",
      "canonicalEffect": "shader.linearGradient"
    },
    {
      "from": "colored_overlay",
      "canonicalEffect": "shader.coloredOverlay"
    },
    {
      "from": "bevel",
      "canonicalEffect": "shader.bevel"
    }
  ]
}
