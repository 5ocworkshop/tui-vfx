      "description": "Human-approved representative GT-Design surface capture.",
      "canonical_surfaces": [
        "GT-Design representative preview/capture flow"
      ]
    },
    "probe_report_json": {
      "description": "Structured recipe-aware probe report and frame-diff evidence.",
      "canonical_surfaces": [
        "recipe-probe",
        "pipeline-validator --probe"
      ]
    },
    "trace_report_json": {
      "description": "Structured lifecycle/resolution/composition/pipeline trace report.",
      "canonical_surfaces": [
        "tui-vfx-trace --format report"
      ]
    },
    "lowering_report_json": {
      "description": "Structured lowering/canonicalization truth surface for role-aware checks.",
      "canonical_surfaces": [
        "pipeline-validator --lowering-report --format json"
      ]
    }
  },
  "gate_defaults": {
